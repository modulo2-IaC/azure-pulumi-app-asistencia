# =============================================================================
# CONFIGURACIÓN DEL PROYECTO UNIFICADO (ASISTENCIA - AZURE HARDWARE)
# Copia este archivo a .env para aprovisionar automáticamente sin comandos manuales:
# cp .env.example .env
# =============================================================================

# ── 1. Base de datos PostgreSQL (Neon Serverless) ────────────────────────────
# Cadena de conexión con SSL activado para la API NestJS
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── 2. Clave secreta para autenticación JWT ──────────────────────────────────
# Si se deja vacío o se omite, el código generará una clave aleatoria segura de 64 caracteres
JWT_SECRET=tu_secreto_super_seguro_jwt_2026

# ── 3. Clave SSH Pública del Administrador de las VMs ─────────────────────────
# Si se deja vacío o se omite, se buscará automáticamente en ~/.ssh/asistencia_vm.pub o ~/.ssh/id_rsa.pub
SSH_PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQC...

# ── 4. Parámetros de la Aplicación ───────────────────────────────────────────
PORT=3000
CORS_ORIGIN=*
APP_TIMEZONE=America/La_Paz
RUN_MIGRATIONS=true

# Credenciales del usuario administrador inicial (creado por seed:admin)
ADMIN_REGISTRATION_NO=123456789
ADMIN_PASSWORD=123456789
ADMIN_FULL_NAME=ADMIN

# ── 5. Repositorios de Código y Ramas (GitHub) ────────────────────────────────
BACKEND_REPO_URL=https://github.com/modulo2-IaC/app-asistencia-backend.git
FRONTEND_REPO_URL=https://github.com/modulo2-IaC/app-asistencia-frontend.git
GIT_BRANCH=dev
VITE_API_URL=/api/v1/
NODE_VERSION=20

# ── 6. Parámetros de Microsoft Azure y VMs ───────────────────────────────────
AZURE_LOCATION=swedencentral
ENVIRONMENT=dev
VM_SIZE=Standard_B2as_v2
ADMIN_USERNAME=azureuser

# ── 7. Metadatos de Azure (Útil para GitHub Actions Secrets) ─────────────────
# ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
